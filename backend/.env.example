# Server Config
PORT=8000
HOST=0.0.0.0

# LLM & Embeddings Provider Options: 'openai', 'google', 'huggingface', 'mock'
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
VECTORSTORE_DIR=./data/vectorstore
UPLOADS_DIR=./data/uploads
